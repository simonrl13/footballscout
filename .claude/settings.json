{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "PowerShell(Get-Content .env*)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(uvx *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "WebFetch"
    ]
  }
}
