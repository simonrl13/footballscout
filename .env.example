# Copy to .env (gitignored) and replace every change-me with a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Postgres admin (only used by the container itself; the app never connects as admin)
POSTGRES_USER=scout_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scout

# App roles, created on first start by db/init/02-roles.sh
SCOUT_LOADER_PASSWORD=change-me
SCOUT_READER_PASSWORD=change-me
LOADER_DATABASE_URL=postgresql://scout_loader:change-me@127.0.0.1:5432/scout
READER_DATABASE_URL=postgresql://scout_reader:change-me@127.0.0.1:5432/scout

# M2+
GUARDIAN_API_KEY=
# M3+
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
NEWS_LLM_ENABLED=false
EMBEDDINGS_ENABLED=false

# M2: MLflow tracking store (created by db/init/03-mlflow.sh, or `python -m scout.ml.setup_mlflow` on an existing volume)
SCOUT_MLFLOW_PASSWORD=change-me
MLFLOW_TRACKING_URI=postgresql+psycopg://scout_mlflow:change-me@127.0.0.1:5432/mlflow

# M3: news pipeline switches (all off until approved)
NEWS_TEXT_PASS_ENABLED=false   # bulk read of article text for player linking (text never stored)
NEWS_LLM_MODEL=claude-haiku-4-5
